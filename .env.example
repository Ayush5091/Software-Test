# MongoDB connection string (MongoDB Atlas free tier or local mongod)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/fitbook

# Secret used to sign JWTs — replace with a long random string
JWT_SECRET=replace-this-with-a-long-random-secret

# Optional: seed script admin account
SEED_ADMIN_EMAIL=admin@fitbook.com
SEED_ADMIN_PASSWORD=Admin@1234
